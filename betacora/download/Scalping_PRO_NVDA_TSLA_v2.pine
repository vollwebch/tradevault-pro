//@version=5
strategy("Scalping PRO NVDA/TSLA v2", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, slippage=2, initial_capital=10000, currency=currency.USD, dynamic_requests=true)

vix_sym = input.symbol("VIX", "VIX Symbol")
vix_long = input.float(18.0, "VIX Long Threshold")
vix_no_trade = input.float(30.0, "VIX No Trade Limit")
qqq_sym = input.symbol("QQQ", "QQQ Symbol")
use_qqq = input.bool(true, "Use QQQ Filter")
ema_fast = input.int(9, "EMA Fast")
ema_slow = input.int(20, "EMA Slow")
use_vwap = input.bool(true, "Show VWAP")
show_pdh = input.bool(true, "Show PDH/PDL")
show_ob = input.bool(true, "Show Order Blocks")
ob_lookback = input.int(20, "OB Lookback")
sl_pct = input.float(0.50, "Stop Loss %", step=0.1)
tp_pct = input.float(1.00, "Take Profit %", step=0.5)
max_trades = input.int(2, "Max Trades/Day")
max_loss_streak = input.int(3, "Max Loss Streak")
daily_loss_limit = input.float(1.5, "Max Daily Loss %")
use_time = input.bool(true, "Filter by Time")
sess1_start = input.int(9, "Morning Start")
sess1_end = input.int(11, "Morning End")
sess2_start = input.int(14, "Afternoon Start")
sess2_end = input.int(15, "Afternoon End")
avoid_monday = input.bool(true, "Avoid Monday")
setup_1 = input.bool(true, "S1: Trend Pullback")
setup_2 = input.bool(true, "S2: Gap Reversal")
setup_3 = input.bool(true, "S3: VIX Crash Reversal")
setup_4 = input.bool(true, "S4: Supply Zone Short")
col_long = input.color(color.teal, "Color LONG")
col_short = input.color(color.red, "Color SHORT")

vix_close = request.security(vix_sym, "D", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
vix_prev = request.security(vix_sym, "D", close[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
vix_high_d = request.security(vix_sym, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
vix_change = vix_close - vix_prev
vix_spike = vix_change > 3.0
vix_bullish = vix_close < vix_long
vix_bearish = vix_close >= vix_long
vix_no_op = vix_close > vix_no_trade

qqq_close = request.security(qqq_sym, timeframe.period, close, gaps=barmerge.gaps_off)
qqq_open_d = request.security(qqq_sym, "D", open, gaps=barmerge.gaps_off)
qqq_bullish = qqq_close > qqq_open_d
qqq_bearish = qqq_close < qqq_open_d

long_allowed = vix_bullish
if use_qqq
    long_allowed := vix_bullish and qqq_bullish

short_allowed = vix_bearish
if use_qqq
    short_allowed := vix_bearish and qqq_bearish

direction = "NONE"
if not vix_no_op and long_allowed
    direction := "LONG"
if not vix_no_op and short_allowed
    direction := "SHORT"

ema_f = ta.ema(close, ema_fast)
ema_s = ta.ema(close, ema_slow)
ema_trend = ema_f > ema_s ? "BULL" : "BEAR"
vwap_val = ta.vwap(hlc3)
atr = ta.atr(14)

pdh = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off)
pdl = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off)
prev_close_d = request.security(syminfo.tickerid, "D", close[1], gaps=barmerge.gaps_off)
prev_open_d = request.security(syminfo.tickerid, "D", open[1], gaps=barmerge.gaps_off)
day_open = request.security(syminfo.tickerid, "D", open, gaps=barmerge.gaps_off)
gap_up = day_open > prev_close_d
gap_down = day_open < prev_close_d
gap_up_pct = gap_up ? ((day_open - prev_close_d) / prev_close_d) * 100 : 0.0
gap_down_pct = gap_down ? ((prev_close_d - day_open) / prev_close_d) * 100 : 0.0

ob_bearish_top = float(na)
ob_bearish_bottom = float(na)
if show_ob
    for i = 1 to ob_lookback
        cb = close[i] - open[i]
        cr = high[i] - low[i]
        if cr > 0 and (cb / cr) < -0.6 and close[i-1] > high[i]
            ob_bearish_top := high[i]
            ob_bearish_bottom := low[i]
            break

ob_bullish_top = float(na)
ob_bullish_bottom = float(na)
if show_ob
    for i = 1 to ob_lookback
        cb = close[i] - open[i]
        cr = high[i] - low[i]
        if cr > 0 and (cb / cr) > 0.6 and close[i-1] < low[i]
            ob_bullish_top := high[i]
            ob_bullish_bottom := low[i]
            break

current_hour = hour(time, "America/New_York")
in_session1 = current_hour >= sess1_start and current_hour <= sess1_end
in_session2 = current_hour >= sess2_start and current_hour <= sess2_end
in_session = use_time ? (in_session1 or in_session2) : true

today_day = dayofweek(time, "America/New_York")
is_monday = today_day == 1
ok_day = avoid_monday ? not is_monday : true

var int trades_today = 0
if ta.change(time("D")) != 0
    trades_today := 0

var int loss_streak = 0

var float daily_pnl = 0.0
if ta.change(time("D")) != 0
    daily_pnl := 0.0
    loss_streak := 0

equity = strategy.equity
daily_pnl := equity - (nz(strategy.equity[1], strategy.initial_capital))
loss_limit_hit = daily_pnl < -(equity * daily_loss_limit / 100)
streak_limit_hit = loss_streak >= max_loss_streak
system_ok = direction != "NONE" and in_session and ok_day and not loss_limit_hit and not streak_limit_hit and trades_today < max_trades

rsi_val = ta.rsi(close, 14)

s1_cond = false
if setup_1 and system_ok and direction == "LONG"
    trend_ok = ema_trend == "BULL"
    near_ob = not na(ob_bullish_bottom) and low <= ob_bullish_top * 1.003 and low >= ob_bullish_bottom
    near_vwap = math.abs(close - vwap_val) / close < 0.005
    in_zone = near_ob or near_vwap
    bullish_candle = close > open and (close - open) > (high - low) * 0.4
    rsi_ok = rsi_val > 40 and rsi_val < 70
    body_big = (close - open) / close > 0.001
    s1_cond := trend_ok and in_zone and bullish_candle and rsi_ok and body_big

s2_cond = false
s2_dir = ""
if setup_2 and system_ok
    in_first_hour = current_hour == 9 or current_hour == 10
    if gap_up and gap_up_pct >= 0.5 and in_first_hour
        bearish_candle = close < open and (open - close) > (high - low) * 0.3
        s2_cond := bearish_candle
        s2_dir := "SHORT"
    if gap_down and gap_down_pct >= 0.5 and in_first_hour
        bullish_candle = close > open and (close - open) > (high - low) * 0.3
        s2_cond := bullish_candle
        s2_dir := "LONG"

prev_drop = prev_open_d > 0 ? ((prev_close_d - prev_open_d) / prev_open_d) * 100 : 0.0

s3_cond = false
if setup_3 and system_ok and direction == "LONG"
    vix_spike_ok = vix_spike
    drop_ok = prev_drop < -2.0
    vix_dropping = vix_close < vix_high_d * 0.98
    bs = math.abs(close - open)
    lw = math.min(open, close) - low
    uw = high - math.max(open, close)
    rng = high - low
    is_hammer = rng > 0 and lw > bs * 2 and uw < bs * 0.5
    is_engulfing = close > open and open < close[1] and close > open[1] and (close - open) > (open[1] - close[1])
    rev_candle = is_hammer or is_engulfing
    in_rev_h = current_hour >= 10 and current_hour <= 12
    s3_cond := vix_spike_ok and drop_ok and vix_dropping and rev_candle and in_rev_h

s4_cond = false
if setup_4 and system_ok and direction == "SHORT"
    vix_ok = vix_close > vix_long
    bearish_trend = ema_trend == "BEAR"
    near_resist = not na(ob_bearish_top) and high >= ob_bearish_bottom * 0.995 and high <= ob_bearish_top * 1.005
    near_pdh_r = high >= pdh * 0.998 and high <= pdh * 1.002
    at_resist = near_resist or near_pdh_r
    bearish_candle = close < open and (open - close) > (high - low) * 0.4
    rej_wick = (high - math.max(open, close)) > (math.abs(close - open)) * 1.5
    s4_cond := vix_ok and bearish_trend and at_resist and (bearish_candle or rej_wick)

long_signal = s1_cond or s3_cond or (s2_cond and s2_dir == "LONG")
short_signal = s4_cond or (s2_cond and s2_dir == "SHORT")

var string active_setup = ""
var float sl_price = na
var float tp_price = na

if long_signal and strategy.position_size == 0 and not loss_limit_hit
    sl_p = close * (1 - sl_pct / 100)
    tp_p = close * (1 + tp_pct / 100)
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl_p, limit=tp_p)
    sl_price := sl_p
    tp_price := tp_p
    trades_today += 1
    if s1_cond
        active_setup := "TREND PB"
    else if s2_cond
        active_setup := "GAP REV L"
    else
        active_setup := "VIX REV"

if short_signal and strategy.position_size == 0 and not loss_limit_hit
    sl_p = close * (1 + sl_pct / 100)
    tp_p = close * (1 - tp_pct / 100)
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl_p, limit=tp_p)
    sl_price := sl_p
    tp_price := tp_p
    trades_today += 1
    if s4_cond
        active_setup := "SUPPLY SH"
    else
        active_setup := "GAP REV S"

if strategy.closedtrades > 0
    last_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if last_pnl > 0
        loss_streak := 0
    else
        loss_streak := loss_streak + 1

if strategy.position_size == 0
    sl_price := na
    tp_price := na

plot(ema_f, "EMA 9", color=color.new(color.orange, 20), linewidth=2)
plot(ema_s, "EMA 20", color=color.new(color.purple, 20), linewidth=2)
plot(use_vwap ? vwap_val : na, "VWAP", color=color.new(color.yellow, 30), linewidth=2, style=plot.style_circles)
plot(show_pdh ? pdh : na, "PDH", color=color.new(color.gray, 40), linewidth=1, style=plot.style_stepline)
plot(show_pdh ? pdl : na, "PDL", color=color.new(color.gray, 40), linewidth=1, style=plot.style_stepline)

plot(show_ob and not na(ob_bullish_top) ? ob_bullish_top : na, "OB Demand", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=2)
plot(show_ob and not na(ob_bullish_bottom) ? ob_bullish_bottom : na, "OB Dem B", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=1)
bgcolor(show_ob and not na(ob_bullish_top) and not na(ob_bullish_bottom) ? color.new(color.blue, 90) : na)

plot(show_ob and not na(ob_bearish_top) ? ob_bearish_top : na, "OB Supply", color=color.new(color.red, 60), style=plot.style_linebr, linewidth=2)
plot(show_ob and not na(ob_bearish_bottom) ? ob_bearish_bottom : na, "OB Sup B", color=color.new(color.red, 60), style=plot.style_linebr, linewidth=1)
bgcolor(show_ob and not na(ob_bearish_top) and not na(ob_bearish_bottom) ? color.new(color.red, 93) : na)

plotshape(long_signal and strategy.position_size == 0, title="LONG", text="LONG", location=location.belowbar, style=shape.labelup, size=size.normal, color=col_long, textcolor=color.white)
plotshape(short_signal and strategy.position_size == 0, title="SHORT", text="SHORT", location=location.abovebar, style=shape.labeldown, size=size.normal, color=col_short, textcolor=color.white)

plot(strategy.position_size > 0 ? sl_price : na, "SL", color=color.new(color.red, 60), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size > 0 ? tp_price : na, "TP", color=color.new(color.green, 60), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? sl_price : na, "SL2", color=color.new(color.red, 60), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? tp_price : na, "TP2", color=color.new(color.green, 60), linewidth=2, style=plot.style_linebr)

bgcolor(strategy.position_size > 0 ? color.new(color.teal, 93) : na, title="LONG BG")
bgcolor(strategy.position_size < 0 ? color.new(color.red, 93) : na, title="SHORT BG")

if long_signal and strategy.position_size == 0
    label.new(bar_index, high, active_setup, style=label.style_label_up, color=col_long, textcolor=color.white)

if short_signal and strategy.position_size == 0
    label.new(bar_index, low, active_setup, style=label.style_label_down, color=col_short, textcolor=color.white)

var table info_panel = table.new(position.top_right, 2, 11, bgcolor=color.new(#1e222d, 10), border_color=color.new(color.gray, 60), border_width=1)
if barstate.islast
    table.cell(info_panel, 0, 0, "SCALPING PRO v2", text_color=color.white, text_size=size.small, bgcolor=color.new(#2962ff, 0))
    table.merge_cells(info_panel, 0, 0, 1, 0)
    vc = vix_bullish ? color.teal : (vix_bearish ? color.orange : color.red)
    table.cell(info_panel, 0, 1, "VIX", text_color=color.gray, text_size=size.tiny)
    table.cell(info_panel, 1, 1, str.tostring(vix_close, "#.##"), text_color=vc, text_size=size.small)
    table.cell(info_panel, 0, 2, "Signal", text_color=color.gray, text_size=size.tiny)
    vix_txt = vix_bullish ? "LONG OK" : (vix_no_op ? "STOP!" : "SHORT OK")
    table.cell(info_panel, 1, 2, vix_txt, text_color=vc, text_size=size.tiny)
    table.cell(info_panel, 0, 3, "QQQ", text_color=color.gray, text_size=size.tiny)
    table.cell(info_panel, 1, 3, qqq_bullish ? "BULL" : "BEAR", text_color=qqq_bullish ? color.teal : color.red, text_size=size.tiny)
    table.cell(info_panel, 0, 4, "Dir", text_color=color.gray, text_size=size.tiny)
    dc = direction == "LONG" ? color.teal : (direction == "SHORT" ? color.red : color.gray)
    table.cell(info_panel, 1, 4, direction, text_color=dc, text_size=size.small)
    table.cell(info_panel, 0, 5, "Trend", text_color=color.gray, text_size=size.tiny)
    ec = ema_trend == "BULL" ? color.teal : color.red
    table.cell(info_panel, 1, 5, ema_trend, text_color=ec, text_size=size.tiny)
    table.cell(info_panel, 0, 6, "Session", text_color=color.gray, text_size=size.tiny)
    sc = in_session ? color.teal : color.red
    table.cell(info_panel, 1, 6, in_session ? "OPEN" : "CLOSED", text_color=sc, text_size=size.tiny)
    table.cell(info_panel, 0, 7, "Trades", text_color=color.gray, text_size=size.tiny)
    tc = trades_today >= max_trades ? color.red : color.white
    table.cell(info_panel, 1, 7, str.tostring(trades_today) + "/" + str.tostring(max_trades), text_color=tc, text_size=size.tiny)
    table.cell(info_panel, 0, 8, "Streak", text_color=color.gray, text_size=size.tiny)
    lsc = loss_streak >= max_loss_streak ? color.red : color.white
    table.cell(info_panel, 1, 8, str.tostring(loss_streak) + "L", text_color=lsc, text_size=size.tiny)
    table.cell(info_panel, 0, 9, "P&L", text_color=color.gray, text_size=size.tiny)
    pc = daily_pnl >= 0 ? color.teal : color.red
    table.cell(info_panel, 1, 9, str.tostring(daily_pnl, "#.##"), text_color=pc, text_size=size.tiny)
    table.cell(info_panel, 0, 10, "SYS", text_color=color.gray, text_size=size.tiny)
    table.cell(info_panel, 1, 10, system_ok ? "GO" : "STOP", text_color=system_ok ? color.teal : color.red, text_size=size.small)

alertcondition(long_signal and strategy.position_size == 0, title="LONG Signal", message="LONG SIGNAL on {{ticker}}")
alertcondition(short_signal and strategy.position_size == 0, title="SHORT Signal", message="SHORT SIGNAL on {{ticker}}")
alertcondition(vix_spike, title="VIX Spike", message="VIX SPIKE > 3 detected")
alertcondition(loss_limit_hit, title="Daily Limit", message="Daily loss limit hit")
